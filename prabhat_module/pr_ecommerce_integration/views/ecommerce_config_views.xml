<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecommerce_config_form" model="ir.ui.view">
        <field name="name">ecommerce.config.form</field>
        <field name="model">ecommerce.config</field>
        <field name="arch" type="xml">
            <form string="E-commerce Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="platform"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sync_frequency"/>
                            <field name="last_sync_date" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="API Credentials">
                        <group>
                            <field name="api_url" placeholder="https://your-store.myshopify.com"/>
                            <field name="access_token" password="1"/>
                        </group>
                        <group>
                            <field name="api_key"/>
                            <field name="api_secret" password="1"/>
                        </group>
                    </group>
                    
                    <group string="Sync Settings">
                        <group>
                            <field name="auto_sync_products"/>
                            <field name="auto_sync_orders"/>
                            <field name="auto_sync_inventory"/>
                        </group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="pricelist_id"/>
                            <field name="journal_id"/>
                        </group>
                    </group>
                    
                    <group>
                        <button name="test_connection" string="Test Connection" type="object" class="oe_highlight"/>
                    </group>
                    
                    <group string="Manual Sync">
                        <group>
                            <button name="action_sync_products" string="Sync Products" type="object"/>
                            <button name="action_sync_orders" string="Sync Orders" type="object"/>
                            <button name="action_sync_inventory" string="Sync Inventory" type="object"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ecommerce_config_tree" model="ir.ui.view">
        <field name="name">ecommerce.config.tree</field>
        <field name="model">ecommerce.config</field>
        <field name="arch" type="xml">
            <tree string="E-commerce Configurations">
                <field name="name"/>
                <field name="platform"/>
                <field name="active"/>
                <field name="last_sync_date"/>
            </tree>
        </field>
    </record>

    <record id="action_ecommerce_config" model="ir.actions.act_window">
        <field name="name">E-commerce Configuration</field>
        <field name="res_model">ecommerce.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_ecommerce_config" name="E-commerce Integration" 
              parent="sale.menu_sales" 
              action="action_ecommerce_config" sequence="100"/>
    
    <record id="view_ecommerce_order_mapping_tree" model="ir.ui.view">
        <field name="name">ecommerce.order.mapping.tree</field>
        <field name="model">ecommerce.order.mapping</field>
        <field name="arch" type="xml">
            <tree string="Order Mappings">
                <field name="platform"/>
                <field name="platform_order_id"/>
                <field name="odoo_order_id"/>
                <field name="platform_status"/>
                <field name="synced_date"/>
            </tree>
        </field>
    </record>
    
    <record id="action_ecommerce_order_mapping" model="ir.actions.act_window">
        <field name="name">Order Mappings</field>
        <field name="res_model">ecommerce.order.mapping</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>