<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_rate_provider_form" model="ir.ui.view">
        <field name="name">currency.rate.provider.form</field>
        <field name="model">currency.rate.provider</field>
        <field name="arch" type="xml">
            <form string="Currency Rate Provider">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="api_service"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="base_currency"/>
                            <field name="update_frequency"/>
                            <field name="last_update" readonly="1"/>
                        </group>
                    </group>
                    <group string="API Configuration">
                        <field name="api_key" password="1"/>
                    </group>
                    <group string="Auto Update">
                        <field name="auto_update"/>
                    </group>
                    <group>
                        <button name="action_fetch_rates" string="Fetch Rates Now" type="object" class="oe_highlight"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_currency_rate_provider_tree" model="ir.ui.view">
        <field name="name">currency.rate.provider.tree</field>
        <field name="model">currency.rate.provider</field>
        <field name="arch" type="xml">
            <tree string="Currency Rate Providers">
                <field name="name"/>
                <field name="api_service"/>
                <field name="base_currency"/>
                <field name="active"/>
                <field name="last_update"/>
            </tree>
        </field>
    </record>

    <record id="action_currency_rate_provider" model="ir.actions.act_window">
        <field name="name">Currency Rate Providers</field>
        <field name="res_model">currency.rate.provider</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_currency_rate_provider" name="Currency Rate Providers" 
              parent="account.menu_finance_configuration" 
              action="action_currency_rate_provider" sequence="70"/>
</odoo>