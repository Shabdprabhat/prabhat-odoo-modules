<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gst_config_form" model="ir.ui.view">
        <field name="name">gst.config.form</field>
        <field name="model">gst.config</field>
        <field name="arch" type="xml">
            <form string="GST Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="state_id"/>
                        <field name="gstin"/>
                    </group>
                    <group>
                        <field name="auto_ewaybill"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gst_config_tree" model="ir.ui.view">
        <field name="name">gst.config.tree</field>
        <field name="model">gst.config</field>
        <field name="arch" type="xml">
            <tree string="GST Configurations">
                <field name="name"/>
                <field name="company_id"/>
                <field name="gstin"/>
            </tree>
        </field>
    </record>

    <record id="action_gst_config" model="ir.actions.act_window">
        <field name="name">GST Configuration</field>
        <field name="res_model">gst.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_gst_config" name="GST Settings" 
              parent="account.menu_finance_configuration" 
              action="action_gst_config" sequence="60"/>
</odoo>