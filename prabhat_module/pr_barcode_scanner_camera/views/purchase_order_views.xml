<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_barcode_scanner_wizard_form" model="ir.ui.view">
        <field name="name">barcode.scanner.wizard.form</field>
        <field name="model">barcode.scanner.wizard</field>
        <field name="arch" type="xml">
            <form string="Scan Barcode">
                <group>
                    <field name="barcode" placeholder="Enter barcode or product name"/>
                </group>
                <footer>
                    <button name="action_scan_barcode" string="Add Product" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>